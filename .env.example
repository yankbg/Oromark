CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Sync server (server/) — its public HTTPS URL and a shared API key.
# Never put the Postgres connection string here; that lives only in
# server/.env, server-side, and must never be bundled into the app.
SYNC_API_URL=https://your-sync-server.example.com
SYNC_API_KEY=your_sync_api_key
